[Unit]
Description=Read-only counter replica
After=network.target mysql.service
Requires=mysql.service

[Service]
User=counter-replica
Group=counter-replica
WorkingDirectory=/opt/counter-replica
EnvironmentFile=/etc/counter-replica/backend.env
ExecStart=/usr/bin/gunicorn --workers 1 --bind 127.0.0.1:8001 app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
